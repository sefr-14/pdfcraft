@@ -0,0 +1,102 @@
+# Fork-only workflow (sefr-14/pdfcraft), TAB.WINDOW.1 W0: build the disposable multi-window
+# spike (w0-spike/) for 64-bit Windows at one explicitly given commit, as a downloadable
+# Actions artifact. The spike lives only on scratch branches, never on Main; this file is on
+# Main only so that it can be dispatched (GitHub dispatches workflows that exist on the
+# default branch).
+#
+# - Runs only on demand, with the full commit SHA to build. The commit must already be on
+#   GitHub (for example on a pushed scratch branch). Nothing runs on push or pull_request.
+# - No secrets; read-only token; no tag, no release, nothing committed.
+# - Delete this file when TAB.WINDOW.1 W0 is closed.
+
+name: w0 spike windows build
+
+on:
+  workflow_dispatch:
+    inputs:
+      commit:
+        description: Full 40-character SHA of a commit that contains w0-spike/
+        required: true
+        type: string
+
+permissions:
+  contents: read
+
+concurrency:
+  group: w0-spike-windows-${{ inputs.commit }}
+  cancel-in-progress: false
+
+env:
+  CARGO_TERM_COLOR: always
+  CARGO_INCREMENTAL: 0
+  RUST_BACKTRACE: 1
+  TARGET: x86_64-pc-windows-msvc
+
+jobs:
+  windows-x64:
+    name: Windows x64 (W0 spike)
+    runs-on: windows-latest
+    timeout-minutes: 60
+    steps:
+      - name: Validate the commit input
+        shell: bash
+        env:
+          COMMIT: ${{ inputs.commit }}
+        run: |
+          if ! [[ "$COMMIT" =~ ^[0-9a-f]{40}$ ]]; then
+            echo "::error::commit must be one full lowercase commit SHA"
+            exit 1
+          fi
+
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ inputs.commit }}
+          persist-credentials: false
+
+      - name: Require the spike
+        shell: bash
+        run: test -f w0-spike/Cargo.toml || { echo "::error::this commit has no w0-spike/"; exit 1; }
+
+      - uses: dtolnay/rust-toolchain@stable
+        with:
+          targets: ${{ env.TARGET }}
+
+      - uses: Swatinem/rust-cache@v2
+        with:
+          key: w0-spike-windows-x64
+          workspaces: w0-spike -> target
+
+      - name: Build the spike
+        shell: bash
+        working-directory: w0-spike
+        run: cargo build --release --locked --bins --target "$TARGET"
+
+      - name: Package
+        id: name
+        shell: pwsh
+        env:
+          COMMIT: ${{ inputs.commit }}
+        run: |
+          $ErrorActionPreference = 'Stop'
+          $package = "w0-spike-$($env:COMMIT.Substring(0, 7))-windows-x64"
+          $dir = "dist\$package"
+          New-Item -ItemType Directory -Force -Path "$dir\target\release" | Out-Null
+          Copy-Item "w0-spike\target\$env:TARGET\release\w0-spike.exe" "$dir\target\release\"
+          Copy-Item -Recurse w0-spike\windows "$dir\windows"
+          Copy-Item w0-spike\W0-REPORT.md, LICENSE-MIT, LICENSE-APACHE $dir
+          "commit $env:COMMIT" | Set-Content -Encoding ascii "$dir\COMMIT.txt"
+          Compress-Archive -Path $dir -DestinationPath "dist\$package.zip" -Force
+          $hash = (Get-FileHash -Algorithm SHA256 "dist\$package.zip").Hash.ToLowerInvariant()
+          "$hash  $package.zip" | Set-Content -Encoding ascii "dist\$package.zip.sha256"
+          "package=$package" | Add-Content -Encoding ascii $env:GITHUB_OUTPUT
+          "SHA-256 $hash  $package.zip"
+
+      - name: Upload the zip as an artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: ${{ steps.name.outputs.package }}
+          path: |
+            dist/${{ steps.name.outputs.package }}.zip
+            dist/${{ steps.name.outputs.package }}.zip.sha256
+          if-no-files-found: error
+          retention-days: 14
